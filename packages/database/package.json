    "check-types": "tsc --noEmit",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.2",
    "@types/node": "^20.19.41",
    "prisma": "8.0.0-rc.19",
    "tsx": "^4.23.15"
  }
}
